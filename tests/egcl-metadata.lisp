(require :asdf)
(require :egcl-posix)
(defpackage :archive (:use :cl))
(load (merge-pathnames "compat.lisp" *default-pathname-defaults*))
(with-open-file (s "metadata-input" :direction :output :if-exists :supersede)
  (write-string "port test" s))
(egcl-posix:chmod "metadata-input" #o640)
(let ((stat (archive::stat "metadata-input"))
      (native (egcl-posix:stat "metadata-input")))
  (assert (= 9 (archive::stat-size stat)))
  (assert (= #o640 (logand #o777 (archive::stat-mode stat))))
  (assert (archive::isreg (archive::stat-mode stat)))
  (dolist (field '(mode uid gid size mtime ino nlink))
    (let ((name (format nil "STAT-~A" field)))
      (assert (= (funcall (find-symbol name :archive) stat)
                 (funcall (find-symbol name :egcl-posix) native))))))
(assert (handler-case (progn (archive::stat "does-not-exist") nil)
          (egcl-posix:syscall-error () t)))
(format t "ARCHIVE-METADATA-PASS~%")
